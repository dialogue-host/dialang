Codebase
  : _Void
  . { /*
        union of every type found in the codebase
      */
      AnyType : @anyType

      /*
        union of every value found in the codebase
      */
      AnyValue : @anyValue
    }

// apply rule tags and use them in string formatting.
> print! """
  We can reference %Maybe or \{@reference Maybe} and have it as an hyperlink in our printed text.
  We can get its signature \{@signature Maybe} or its complete implementation:
  \{@implementation Maybe}
  or its documentation :
  > \{@documentation Maybe}
  We can unwrap its type \{@alias Maybe}, get its methods \{@methods Maybe}.
  We can also get the expression of a value \{@expression Maybe.map} and its type \{@type Maybe.map}.
  We can escape the \% and \\ symbols either by escaping them with a `\` or by using them inside of backticks as `%Maybe` or `\{@reference Maybe}`.
"""
/*
this will print:
  """
  We can reference [Maybe](dialogue-lang.dev/idal/sample:-maybe) or [Maybe](dialogue-lang.dev/idal/sample:-maybe) or [Maybe](dialogue-lang.dev/idal/sample:-maybe) and have it as an hyperlink in our printed text.
  We can get its signature `Maybe a : [ #just a | #nothing ] with { map }`, its complete implementation:
  ```
  /*
      We use %Maybe when we are unsure to get our value. It has a %map method.
  */
  Maybe a
    : [ #just a | #nothing ]
    . {

        /*
          Documentation for Maybe.map
        */
        map
          : (a -> b), Maybe a -> Maybe b
          = { func, #just a -> #just (func a)
            | _, #nothing -> #nothing
            }

      }
  ```
  or its documentation :
  > We use [Maybe](dialogue-lang.dev/idal/sample:-maybe) when we are unsure to get our value. It has a [Maybe.map](dialogue-lang.dev/idal/sample:-maybe.map) method.
  We can unwrap its type `[ #just a | #nothing ]`, get its methods `{ map }`.
  We can also get the implementation of a value `{ func, #just a -> #just (func a) | _, #nothing -> #nothing }` and its type `(a -> b), Maybe a -> Maybe b`.
  We can escape the % and \ symbols either by escaping them with a `\` or by using them inside of backticks as `%Maybe` or `\{@reference Maybe}`.
  """
*/


Codec
  : interface
  (
    encode : a -> Json
    decode : Json -> Maybe a

    /*
        We can put functions in our @expect. Its parameters must fulfill the Fuzz interface as it will be tested for 100 random values.
        Here as it is an interface, the @expect will only be tested for every type `where t implements Codec`.

        WIP: actually we want to distinguish @test and @prove which will both be rule tags.
    */
    @expect (val -> val |> encode |> decode == #just val)

  )

sendJson
  : Url, a -{Http}-> Void
    where a implements Codec
  = todo

/*
  One can extend existing types (here List comes from dialang/core/List) with new methods.
*/
List
  : extend List
  . { getAt
        : Nat, List(a) -> Maybe a
        = { 0, head :+ _ ->
              #just(head)

          | index, _ :+ tail where index > 0 ->
              getAt(index - 1, tail)

          | _, _ ->
              #nothing

          }
    }

// compare and match types
@expect (@type(List.getAt) == { Nat, List a -> Maybe a })
@expect (Type.match { a : String, b : Int } { a : String, .. {)

// Byte, List and Record are the three core types of dialang
// specifying the byte count is mandatory however list length isn't and record fields are automatically found by the compiler
Bits<count : Amount> : core . { todo )

List<length : Maybe Amount> element : core . { todo )

Record<fields : List { index : Field.Index, type : Type.Ref }, extensible : Maybe Extension> : core . { todo )

Union<variants : List { index : Tag.Index, arguments : List Type.Ref }, extensible : Maybe Extension> : core . { todo )

Function<args : List Type.Ref, ret : Type.Ref> : core . { todo )

Interface<methods : List Type.Ref> : core . { todo )

Fallible<errors : List error> a : core . { todo }
Effectful<effects : List effect> a : core . { todo }

Platform effect : core . { todo }

TypeAlias<type : Type.Ref, args : List Type.Ref, methods : List { type : Type.Ref, expr : Expr.Ref }> : core . { todo )

Extension
  : [ #unspecified
    | #specified VarType.Ref
    ]

Variant
  : [ #tagged { name : Tag.Name.Ref, arguments : List Type.Ref }
    | #untagged Type.Ref
    ]

Interface : List { name : Name.Ref, type : Type.Ref }

Record.Field : { name : Field.Name.Ref, type : Type.Ref }

Value
: _(Void)
. { Declaration : { name : Name.Ref, type : Type.Ref, expr : expr }
    Signature : { name : Name.Ref, type : Type.Ref }
  }

Declaration : [ Value.Declaration | Type.Alias.Declaration ]

Scope : [ #public | #private ]

Type
  : _(Void)
  . { /*
        Type.Alias is an alias of a type.
      */
      Alias staticArg arg
        : { name : Name.Ref
          , scope : Scope
          , type : Type.Ref
          , staticParams : List { name : Name.Ref, type : Type.Ref, ..staticArg }
          , params : List { name : Name.Ref, type : Type.Ref, ..arg }
          , methods : List { name : Name.Ref, type : Type.Ref, expr : Expr.Ref }
          }
        . { Declaration : TypeAlias {} {}
          , Signature : TypeAlias { arg : Expr.Ref } { arg : Type.Signature.Ref }
          }

    , Variable : _Void.{ Ref : _Void }

    , Signature
        : [ #core
          | #blank
          | #var Type.Var.Ref
          | #conditionals
              { implements : List {varType : VarType.Index, interface : Interface.Ref}
              , has : List {varType : VarType.Index, methods : List { name : Name.Ref, type : Type.Ref }}
              }
              Type.Signature
          | #typeAlias Alias.Signature
          ]

    }

Matrix<row : Nat, col : Nat> : List<row> (List<col> Float) with {

  transpose
    : Matrix<row,col> -> Matrix<col,row>
    = todo

}

// these are equivalent
recA : { hello : Str, .. } -> Str
recB : { hello : Str } & _ -> Str

// and these too
recC : { hello : Str, ..a } -> a
recD : { hello : Str } & a -> a
// here a is a record that doesn't contain the `hello` field

// cash a set amount of results to avoid repeated computation of the function
memoize : Nat, (a -> b), a -> b



|>  { a -> do_one_thing
    | b -> do_something_else
    }

when2
  something
  somethingElse
  { a, b ->
      do_one_thing
  | c, d ->
      do_something_else
  }

while
  { acc -> #true }
  initial
  { acc -> do_something }

// %Fallible and %Effectful types are used to track and handle errors as well as side effects
Fallible<errors : List error> a : core
Effectful<effects : List effect> a : core

// If not explicitly stated, every type is considered to have `? []` attached which means they never fail.
// infix functions are all set by the language
|> : (a, a -> b) -> b
|? : (a ? e, e -> a) -> a

Errors : [ ?http String | ?divideByZero ]
Effects : [ !readFile | !network ]

Fallible.default : (a, a ? _) -> a
always : (a, _) -> a

// type that is impossible to instantiate.
Never : [ #never Never ]
never : Never -> a

/*
## kinds of file
- module : Set of values and types. Values are considered as methods of the homonymous type.
- interface : Module with a filler homonymous type. It only contains methods type signatures.
- program
- package
*/




// More recent syntax

List(len : Nat, a)
  = [ #nil where len == 0
    | #cons(a, List k a) where len == k + 1
    ]

Matrix(row : Nat, col : Nat, a)
  = List(row, List(col, a))

  . transpose
      : Matrix(col, row, a)
      = @todo

BalancedBinaryTree(depth : Nat, a)
  = [ #leaf(a) where depth == 0
    | #branch(BalancedBinaryTree(k, a), a, BalancedBinaryTree(k, a)) where depth == k + 1
    ]

// for a given depth, BalancedBinaryTree has to have a single possible shape.

Range(a)
  = { min : a, max : a } where min <= max

  . isWiderThan
      : Range(a) -> Bool
      = { r -> self.min <= r.min && self.max >= r.max }


Bounded(min : a, max : a, a)
  = a where min <= val <= max

  . extendBound
      : nMin, nMax, Bounded min max a -> Bounded nMin nMax a
        where nMin <= min && nMax >= max
      = { val -> val }

Eq(eq : t, t)
  = t where @forall{val : t -> val == eq}

GreaterThan(min : t, t)
  = t where (val : t) >= min

  . sum
      : GreaterThan(minB, t) -> GreaterThan(min + minB, t)
      = { b -> t.sum(self, b) }

StrictlyGreaterThan(min : a, a)
  = a where val > min

LesserThan(max : a, a)
  = a where val <= max

StrictlyLesserThan(max : a, a)
  = a where val < max

Order = [ #lesserThan | #equal | #greaterThan ]

compare : t, t -> Order
  = case(
      t,
      { #type -> { a, b -> a == b}
      | #bits(count) -> ...
      }
    )

Comparable(t)
  = t where
      ( t.compare : t -> Order where
          forall{ (a : t), b, c ->
            let order = a.compare(b) in
            order == b.compare(c) ==> order == a.compare(c)
          }
      )

  . bound
      : min, max -> [ Bounded(min, max, t) | #outOfBound ]
      = { where min <= self <= max -> self
        | _ -> #outOfBound
        }


// The `@assume` rule can be used on statements that can't be automatically proven. It will be thoroughly fuzz tested.
Int = core

  . compare
      : Int, Int -> Order where
          forall{ (a : Int), b, c ->
            let order = a.compare(b) in
            order == b.compare(c) ==> order == a.compare(c)
          }
      = @todo


Percent = Bounded(0, 1, Float)
Odd = Int where i % 2 == 1
MultipleOf(mult : num, num) = num where n % mult == 0
Even = MultipleOf(2, Int)
Nat = GreaterThan(0, Int)
Maybe(t) = [ t | #nothing ]
Nullable(t) = [ t | #null ]

/* type */
Type
  = [ #type
    | #bits(Nat)
    | #var(Var.Ref, Maybe(Type))
    | #alias(Alias.Ref, Type)
    | #record(List(Field.Ref, Type))
    | #tag(Tag.Ref, Type)
    | #union(OSet(Type))
    | #tuple(List(Type))
    | #function(args : Type, effects : Type, return : Type)
    | #where(Type, Expr(Bool))
    | #static(Expr(#any))
    ]
