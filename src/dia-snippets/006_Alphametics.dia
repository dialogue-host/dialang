# Alphametics

This puzzle comes from the [Roc track on Exercism](https://exercism.org/tracks/roc/exercises/alphametics).

We want to solve it in Dialang to see if we can stretch its design on such a difficult exercise.

We are given a [verbal arythmetic](https://en.wikipedia.org/wiki/Verbal_arithmetic) sum and we have to figure the number-letter correspondence.

*/


Digit := Int.Range(0, 9)
Letter := c:Char where Char.isUpper(c)
Word := NeList(Letter)
Equation := (.leftSum:NeList(Word),.rightSum:NeList(Word))
Solution := d:Dict(Letter, Digit) where Dict.values(d) |> List.isUnique


solve
  : Equation -> [ Solution | #noSolution ]
  = { (.leftSum, .rightSum) ->
        letters
          = ( leftSum ++ rightSum
              |> List.concat
              |> List.unique
            )

        if List.length(letters) > 10
        return #noSolution

        digits
          = Int.range(0, 9)

        forEachMapping
          : (Solution -> Bool) -> { Solution | #noSolution }
          = { l=[lh, ..lq], [dh, ..dq], tried, mapping ->
                recurse = self
                recurse( is_solution, lq, dq ++ tried, [], [(lh, dh), ..mapping] )
                |%> { #notFound -> recurse( is_solution, l, dq, [dh, ..tried], mapping ) }

            | [], _, _, mapping, .is_solution ->
                if is_solution(mapping)
                then mapping
                else #notFound

            | [_, ..], [], _, mapping ->
                if mapping == []
                then #noSolution
                else #notFound

            }(letters, digits, [], [], .is_solution=$)


        forEachMapping <|| possibleSolution ->

        wordToNat
          : Word -> Nat
          = List.foldl(
              { c, acc -> acc * 10 + Dict.get(c, possibleSolution)},
              0, $
            )

        sumWords
          : List(Word) -> Nat
          = List.foldl(
              { w, acc -> acc + wordToNat(w) },
              0, $
            )

        sumWords(leftSum) == sumWords(rightSum)
    }


strToEq
  : Str -> [ Equation | #invalidEquation ]
  = { str ->
        equation_regex
          : Regex(Equation)
          = ( wordRegex = " *([A-Z]+) *"
              summed_words_regex = "${wordRegex}(#:\+${wordRegex})*"
              eq_regex = "/^${summed_words_regex}==${summed_words_regex}$/"
              matchingToEq
                = { (hl, ll, hr, lr) ->
                      (.leftSum=[hl, ..ll], .rightSum=[hr, ..lr])
                  }

              Regex.from_str(eq_regex)
              |> Regex.map(matchingToEq, $)
            )

        Regex.match(equation_regex, eq)
        |%> { #noMatch -> #invalidEquation }
    }


strToEqWithoutRegex
  : Str -> { Equation | #invalidEquation }
  = { [' ', ..q], maybe_word, ls, rs ->
        self(q, maybe_word, ls, rs)

    | ['+', ..q], w:Word, ls, #reading_left ->
        self(q, #nothing, [..ls, w], #reading_left)

    | ['+', ..q], w:Word, ls, #reading_right(rs) ->
        self(q, #nothing, ls, #reading_right([..rs, w]))

    | "==" ++ q, w:Word, ls, #reading_left ->
        self(q, #nothing, [w, ..ls], #reading_right([]))

    | str, #nothing, ls, rs ->
        chompWhile(Char.isUpper, str)
        |> { "", _ -> #invalidEquation
           | w:Word, rest ->
                self(rest, w, ls, rs)
           }

    | "", w:Word, ls, #reading_right(rs) ->
        (.leftSum=ls, .rightSum=[w, ..rs])

    | _ ->
        #invalidEquation

    }($, #nothing, [], #reading_left)


chompWhile
  : (Char -> Bool), Str -> (Str, Str)
  = { valid, [h, ..q], acc where valid(h) ->
        self(valid, q, [..acc, h])

    | _, rest, acc ->
        (acc, rest)

    }(..$, "")
