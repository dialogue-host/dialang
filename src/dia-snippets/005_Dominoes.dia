# Dominoes

This puzzle comes from the [Roc track on Exercism](https://exercism.org/tracks/roc/exercises/dominoes).

We want to solve it in Dialang to see if we can stretch its design on such a difficult exercise.

Make a chain of dominoes.
Compute a way to order a given set of domino stones so that they form a correct domino chain. In the chain, the dots on one half of a stone must match the dots on the neighboring half of an adjacent stone. Additionally, the dots on the halves of the stones without neighbors (the first and last stone) must match each other.
For example given the stones [2|1], [2|3] and [1|3] you should compute something like [1|2] [2|3] [3|1] or [3|2] [2|1] [1|3] or [1|3] [3|2] [2|1] etc, where the first and last numbers are the same.
For stones [1|2], [4|1] and [2|3] the resulting chain is not valid: [4|1] [1|2] [2|3]'s first and last numbers are not the same (4 != 3).
Some test cases may use duplicate stones in a chain solution, assume that multiple Domino sets are being used.

*/

Domino := (Nat, Nat)

rev = List.revert

/*
  Pop's the matching dominoes out of the bag.
*/
match
  : Nat, List(Domino) -> (.matching:List(Domino), .non_matching:List(Domino))
  = { n, bag ->
        { [h, ..q], matching, non_matching where n == h.1 ->
            self(q, [h, ..matching], non_matching)

        | [h, ..q], matching, non_matching where n == h.0 ->
            self(q, [rev(h), ..matching], non_matching)

        | [h, ..q], matching, non_matching ->
            self(q, matching, [h, ..non_matching])

        | [], matching, non_matching ->
            (.matching, .non_matching)

        }(bag, [], [])
    }

/*
  Return a valid circle of dominoes.
*/
find_chain
  : List(Domino) -> [ List(Domino) | #dead_end | #disjointed_graph ]
  = { [first, ..bag], [], [] ->
        self(bag, [], [first])

    | bag, [], acc is [prev, ..] ->
        (.matching, .non_matching) = match(prev.0, bag)
        if matching == []
        then #disjointed_graph
        else self(non_matching, matching, acc)

    | bag, [h, ..q], acc ->
        recurse = self
        recurse([..q, ..bag], [], [h, ..acc])
        |%> { #dead_end -> recurse([h, ..bag], q, acc) }

    | [], [], solution is [h, .., l] where h.0 == l.1
    | [], [], solution is [h] where h.0 == h.1 ->
        solution

    | [], [], [] ->
        []

    | _ ->
        #dead_end

    }($, [], [])
