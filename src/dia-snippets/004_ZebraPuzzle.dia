# Zebra Puzzle

This puzzle comes from the [Unison track on Exercism](https://exercism.org/tracks/unison/exercises/zebra-puzzle).

We want to solve it in Dialang to see if we can stretch its design on such a difficult exercise.

We need to figure out :
- Which of the residents drinks water?
- Who owns the zebra?

While knowing that :
- There are five houses.
- The Englishman lives in the red house.
- The Spaniard owns the dog.
- The person in the green house drinks coffee.
- The Ukrainian drinks tea.
- The green house is immediately to the right of the ivory house.
- The snail owner likes to go dancing.
- The person in the yellow house is a painter.
- The person in the middle house drinks milk.
- The Norwegian lives in the first house.
- The person who enjoys reading lives in the house next to the person with the fox.
- The painter's house is next to the house with the horse.
- The person who plays football drinks orange juice.
- The Japanese person plays chess.
- The Norwegian lives next to the blue house.

For this problem I've stretched Dialang syntax and added `if-return` and `<-` syntax.
It would be nice to find alternative implementations that do not add that much new syntax.

*/

House := Int.Range(0, 4) // == { 0 | 1 | 2 | 3 | 4 }
Solution := ( .water_drinker:String, .zebra_owner:String )
every_house = Int.range(0,4)

each
  : (House -> { Solution | ?dead_end }) -> { Solution | ?dead_end }
  = { solver ->
        every_house
        |>{ [house, ..rest] ->
              recurse = self
              solver(house)
              |%> { ?dead_end -> recurse(rest) }
          | [] ->
              ?dead_end
          }
    }

is_not_neighbor
  = { a, b -> a /= b + 1 && a /= b - 1}

solve : Solution =
  ( norwegian = 0 // first house
    milk = 2 // middle house

    englishman <- each
    red = englishman
    if norwegian == englishman
    return ?dead_end

    spaniard <- each
    dog = spaniard
    if
      norwegian == spaniard
      || englishman == spaniard
    return ?dead_end

    ukrainian <- each
    tea = ukrainian
    if
      norwegian == ukrainian
      || englishman == ukrainian
      || spaniard == ukrainian
      || milk == tea
    return ?dead_end

    japanese <- each
    chess = japanese
    if
      norwegian == japanese
      || englishman == japanese
      || spaniard == japanese
      || ukrainian == japanese
    return ?dead_end

    ivory <- each
    green = ivory + 1 // to the right
    coffee = green
    if
      green == 5 // out of bound
      || red == ivory
      || red == green
      || milk == coffee
      || tea == coffee
    return ?dead_end

    yellow <- each
    painter = yellow
    if
      red == yellow
      || green == yellow
      || ivory == yellow
      || painter == chess
    return ?dead_end

    blue <- each
    if
      red == blue
      || green == blue
      || ivory == blue
      || yellow == blue
      || is_not_neighbor(norwegian, blue)
    return ?dead_end

    snail <- each
    dancing = snail
    if
      dog == snail
      || chess == dancing
      || painter == dancing
    return ?dead_end

    fox <- each
    if
      dog == fox
      || snail == fox
    return ?dead_end

    horse <- each
    if
      dog == horse
      || snail == horse
      || fox == horse
      || is_not_neighbor(painter, horse)
    return ?dead_end

    orange_juice <- each
    football = orange_juice
    if
      milk == orange_juice
      || tea == orange_juice
      || coffee == orange_juice
      || chess == football
      || painter == football
      || dancing == football
    return ?dead_end

    reading <- each
    if
      chess == reading
      || painter == reading
      || dancing == reading
      || football == reading
      || is_not_neighbor(reading, fox)
    return ?dead_end

    water <- each
    if
      milk == water
      || tea == water
      || coffee == water
      || orange_juice == water
    return ?dead_end

    zebra <- each
    if
      dog == zebra
      || snail == zebra
      || fox == zebra
      || horse == zebra
    return ?dead_end

    owner
      : Home -> String
      = { h where h == englishman -> "Englishman"
        | h where h == spaniard -> "Spaniard"
        | h where h == ukrainian -> "Ukrainian"
        | h where h == norwegian -> "Norwegian"
        | h where h == japanese -> "Japanese"
        }

    ( .water_drinker = owner(water)
    , .zebra_owner = owner(zebra)
    )
  )
