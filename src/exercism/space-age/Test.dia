*/

namespace SpaceAge as *


almost
  : Year, Year, .tolerance := 0.01 -> Bool
  = { #year(val), #year(expected), .tolerance ->
        abs(expected - value) <= tolerance
    }

/// description = age on Earth
expect almost(age(#earth, 1_000_000_000), 31.69)

/// description = age on Mercury
expect almost(age(#mercury, 2_134_835_688), 280.88)

/// description = age on Venus
expect almost(age(#venus, 189_839_836), 9.78)

/// description = age on Mars
expect almost(age(#mars, 2_129_871_239), 35.88)

/// description = age on Jupiter
expect almost(age(#jupiter, 901_876_382), 2.41)

/// description = age on Saturn
expect almost(age(#saturn, 2_000_000_000), 2.15)

/// description = age on Uranus
expect almost(age(#uranus, 1_210_123_456), 0.46)

/// description = age on Neptune
expect almost(age(#neptune, 1_821_023_456), 0.35)
