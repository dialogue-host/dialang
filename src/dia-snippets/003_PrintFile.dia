
# Print File

This cli tool prints the content of the file given as first argument.
*/

main
  : .args:List(String) ! Cli.Cap -> Cli.ExitCode
  = { .args=[] ->
        _printErr!( "You need to provide a file path as first argument." )

    | .args=[filePathStr, ..] ->
        Fs.Path.fromString(filePathStr)
        |> !read
        |>  { #invalidFilePath ->
                """The first argument "${filePathStr}" has to be a valid file path."""
                |> _printErr!

            | #fileNotFound ->
                """No file found at "${filePathStr}"."""
                |> _printErr!

            | #accessDenied ->
                """This script doesn't have the authorization to read "${filePathStr}"."""
                |> _printErr!

            | fileContent:Str ->
                !print(fileContent)
                #success

            }
    }

_printErr
  = { errTxt ->
        !print(errTxt, .out=#stderr)
        #genericError
    }
