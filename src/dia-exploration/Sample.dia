// %Fallible and %Effectful types are used to track and handle errors as well as side effects
Fallible<errors : List error> a : core
Effectful<effects : List effect> a : core

Errors : [ ?http String | ?divideByZero ]
Effects : [ !readFile | !network ]

Fallible.default : (a, a ? _) -> a
always : (a, _) -> a

// If not explicitly stated, every type is considered to have `? []` attached which means they never fail.
// infix functions are all set by the language
|> : a, (a -> b) -> b
<| : (a -> b), a -> b
>> : (a -> b), (b -> c) -> (a -> c)
<< : (b -> c), (a -> b) -> (a -> c) // unsure this is a good one to keep
|>_ : _, a -> a
|(?my_err)> : { ?my_err | a }, a -> a
|(#my_tag(..struct))> : { #my_tag(..struct) | a }, (struct -> b) -> { b | a }
|(val:MyType)> : { MyType | a }, (MyType -> b) -> { b | a }

// type that is impossible to instantiate.
Never : #never(Never)
never : Never -> a

/*
## kinds of file
- module : Set of values and types. Values are considered as methods of the homonymous type.
- interface : Module with a filler homonymous type. It only contains methods type signatures.
- program
- package
*/


// More recent syntax

List := t -> [ #leaf | #cons(t, List(t)) ]

  .length : Nat
      = ( loop
            : List(t), Nat -> Nat
            = { #leaf, acc -> acc
              | #const(_, subList), acc ->
                  loop(subList, acc + 1)
              }

          loop(self, 0)
        )

  .member : t -> Bool
      = { [ h, .. ], v where h == v -> #true
        | [ _, ..q ], v -> q.member(v)
        | [], _ -> #false
        } self

  .hasNoDuplicates : Bool
      = ( loop
            : List(t), List(t) -> Bool
            = { seen, [ h, ..q ] ->
                  ifThenElse(
                    seen.member(h),
                    #false,
                    loop([ h, ..seen ], q)
                  )
              | _, [] -> #true
              }

          loop([], self)
        )

UList(t) := l:List(t) where List.hasNoDuplicates(l)

Vec(len:Nat, t) := list:List(t) where List.length(list) == len

Matrix(row:Nat, col:Nat, a) := Vec(row, Vec(col, a))

  . transpose
      : Matrix(col, row, a)
      = ?

BalancedBinaryTree(depth : Nat, a)
  = { where depth == 0 -> #leaf(a)
    | where depth == k + 1 -> #branch(BalancedBinaryTree(k, a), a, BalancedBinaryTree(k, a))
    }

// for a given depth, BalancedBinaryTree has to have a single possible shape.

Range
  := t -> { min:t, max:t } where min <= max

  .isWiderThan
      : Range(t) -> Bool
      = { r -> self.min <= r.min && self.max >= r.max }


Bounded
  := min:t, max:t, t -> v:t where min <= v <= max

Eq
  := eq:t, t -> v:t where v == eq

GreaterThan
  := min:t, t -> v:t where v >= min

  . sum
      : GreaterThan(minB, t) -> GreaterThan(min + minB, t)
      = { b -> t.sum(self, b) }

Order := [ #lesserThan | #equal | #greaterThan ]

compare : t, t -> Order
  = { a, b where t == Int -> @todo
    | (ha, ..ra), (hb, ..rb) ->
        compare ha hb && compare ra rb
    | _, _ -> @todo
    }

isComparable
  : Type -> Bool
  = { t ->
        t has .compare : t -> Order where
          @forall({ a:t, b, c ->
            order = a.compare(b)
            order == b.compare(c) ==> order == a.compare(c)
          })
    }

Int := Type // := Type is reserved to core types
  . compare
      : Int -> Order where
          @forall({ a:Int, b, c ->
            order = a.compare(b)
            order == b.compare(c) ==> order == a.compare(c)
          })
      = @todo
  . div
      : i:Int -> Int where i != 0
      = @todo


Percent := Bounded(0, 1, Float)
Odd := i:Int where i % 2 == 1
MultipleOf := mult:num, num -> val:num where val % mult == 0
Even := MultipleOf(2, Int)
Nat := GreaterThan(0, Int)
PNat := i:Int where i > 0
Maybe(t) := [ t | #nothing ]
Nullable(t) := [ t | #null ]

/* type */
Type
  : [ #type
    | #bits([ 8 | 16 | 32 | 64 | 128 ])
    | #var(Type.Var.Ref, Maybe(Type))
    | #custom(Type.Custom.Ref)
    | #record({ fields : List((Field.Ref, Type)), extensible : Maybe(Type.Var.Ref) })
    | #tag(Tag.Ref, Type)
    | #union(UList(Type))
    | #tuple(List(Type))
    | #function(args : Type, effects : Type, return : Type)
    | #where(Type, Expr(Bool))
    | #static(Expr(#any))
    ]

Field.Ref
  = Name.Lower.Ref


sum : Int, Int -> [ Int | ?intOverflow ]

sumWithDefault
  : Int, Int, Int -> Int
  = { a, b, default ->
      sum(a, b)
      |?intOverflow default

      /* equivalent to
      ```
      sum(a, b)
      |>{ ?intOverflow -> default
        | i -> i
        }
      ```
      */
    }

// for up and downcasting
cast
  : t:Type, v -> [ t | ?impossibleCast ]
  = ?


/*
### Language representations

As in most languages:
`()` are used for operation priority and may be used for scoping tuples and function arguments,
`{}` are used for function definition as well as record signature and declaration,
`[]` are used for declaring lists as well as scoping union type signatures.

Somewhat peculiarly:
`,` is an infix operator grouping both sides into a tuple or splitting elements of a list,
`|` is an infix operator grouping types from both sides into an union or to separate the different branches of a function,
`->` is an infix operator describing a function that sends the left type to the right one, it also separates the pattern match made on function's parameters form its implementation,
`?` is an infix operator splitting a type signature into its error tags (on the right) and other variants (on the left),
`:` serves to declare the type of a symbol in a definition or in a pattern but in an expression it is a boolean operator returning `#true` if the left side exists and matches the given type,
`=` is used to define a symbol's implementation or to set a record's field,
`:=` is used to define a type's implementation,
`where` is an infix operator that takes a type signature or a matched pattern and a boolean and statically ensures that the boolean is always true.

The boolean operators are the following infix:
`==`, `!=`, `<=`, `>=`, `<`, `>`, `&&`, `||`, `==>`, `<==>`, the unary `!` and the subtyping relations `<:` and `>:`.

There are also the mathematical infix operators:
`+`, `-`, `*`, `/`, `^` and the unary `-`.

The construct infixes are:
`++` to append two `String`s or `List`s,
`&` to union two records, tuples, `Set`s or `Dict`s,
`..` notation can be used to match a list `[ h, .., e ]`, `[ h, ..q, e ]` where `h` is the first element, `e` the last and - in the second case - `q` is a list containing every other element,
the same notation can be used to construct a list `[ ..listA, elemB, ..listC ]`,
`..` notation can be used to mach a record `{ fieldA, fieldB, ..r }` where `r` is a record containing all other fields,
but also to update an existing record `newCoords = { x = 13, ..coords }` (here if `coords == {x = 2, y = 5} then `newCoords == {x = 13, y = 5}`).

There are three pipe infix operators:
`|>`, `<|`, `|?` where the third one does `t ? e, (e -> t) -> t`.

There are two kinds of tags:
`#normalTag` and `?errorTag` which both can have attached arguments.
Error tags also contains data about the way it has been thrown `{ ?myErr -> myErr.msg }`.

Using `_` as first character of a tag, record field, type name or value name makes it is private.

`Char`s are UTF-8 graphemes with their modifiers, not necessarily 8-bit as in C.

Some syntax sugar:
a record instantiation may not use `=` at all if there is a value in scope that has the same name as the record field,
`=|>` can be used in a record instantiation if there is a value in scope that has the same name as the record field to give a `filedType -> fieldType` function on its right side,
`$` can be used as a placeholder turning `func $ arg2` into `{arg1 -> func arg1 arg2}`,
`as` can be used in patterns and on module imports in the same way as in Elm.

*/


/*
### Moving values between type signature and implementation

These are all equivalent:
```
// Type declaration
Matrix := row:PNat -> col:PNat -> a:Type -> Vec(row, Vec(col, a))
```
<==>
```
// Thanks to type inference
Matrix := row -> col -> a -> Vec(row, Vec(col, a))
```


Arguments of a function can be used in its type signature:
```
cast : target:Type, origin -> [ target | ?impossibleCast ]
printf : str:String, PrintfArgs(str) -#stdout(String)-> Void
```
but those have to be evaluated statically otherwise the compiler won't be able to type check.
*/


OneOf(t) := { #this t | #that t | #other t }

// patterns can be grouped as long as they expose the same params (same name and type)
unwrap
  : OneOf(t) -> t
  = { #this v
    | #that v
    | #other v ->
        v
    }

// optional record field
Options := ( ~darkMode : Bool = #false )
view : Options -> Html msg = ?
@> view (~)
@> view ( darkMode = #true )


// side effects
Task.await : ( Task(msg), .blocking : Bool = #true ) -> msg
// if `blocking` is `#true` then wait for response before running other side effects
// using Task.await wraps first named parent function's output into a `Task`
// is not compatible with variable parameters
Task.mock : msg -> Task(msg)
Task.map : (a -> b), Task(a) -> Task(b)
Task.andThen : (a -> Task(b)), Task(a) -> Task(b)

// might use `!` notation for await?
// `cap.print!("Hello World!")`
// <==> `cap.print("Hello World!") |> Task.await`
// makes await less explicit which isn't ideal
// but might happen so often that it would become annoying
// though it encourages to write pure functions

// could work with feeds
Feed.push : Task(msg), Feed(msg) -> Feed(msg)
Feed.pull : Feed(msg) -> msg
Feed.map : (a -> b), Feed(a) -> Feed(b)
Feed.andThen : (a -> Feed(b)), Feed(a) -> Feed(b)
Feed.merge : Feed(a), Feed(b) -> Feed({a|b})

// or update loop
init : cap, flags -> state, Task(msg)
update : cap, msg, state -> state, Task(msg)

// alternative design for side effecs
Interface(msgOut, msgIn)
  := ( .await! : msgOut -> msgIn
     , .await_timeout! : Duration, msgOut -> {msgIn | ?timeout}
     //, .subscribe! : subscription -> ()
     //, .push! : msgOut -> ()
     //, .pull! : msgIn
     //, .pull_timeout! : Duration -> {msgIn | ?timeout}
     //, .queue_length! : Nat
     //, .subscriptions! : Set(subscription)
     )
Runtime(flags, msgOut, subscription, msgIn, state)
  := ( .init! : Interface(msgOut, msgIn), flags -> state, msgOut
     , .update! : Interface(msgOut, msgIn), msgIn, state -> state, msgOut
     )
// constrain access by mapping on the interface
namespace Interface as Itf
Itf.mapMsgOut : (a -> b), Itf(a, s, i) -> Itf(b, s, i)
Itf.mapSubscription : ((a -> b), (b -> a)), Itf(o, a, i) -> Itf(o, b, i)
Itf.mapMsgIn : (a -> b), Itf(o, s, a) -> Itf(o, s, b)
Itf.merge : Itf(oa, sa, ia), Itf(ob, sb, ib) -> Itf({oa|ob}, {sa|sb}, {ia|ib})

// ## handle capabilities implicitly
// current favorite
Print := ( .print:( String -> () ), .. )
printIf
  : Bool, String, .cap:Print -> ()
  = { #true, str -> cap.print(str)
    | #false, _ -> ()
    }
// using `!` when calling a function thakes the parent's `.cap` in its args
log : String, .verbose:Bool, .cap:Print -> ()
  = printIf!(verbose, $) // == { str -> printIf(verbose, str, .cap) }
// short running side effects (random, hash, print, encrypt, fs, ...) are run immediately (`_ -> ()` signatures)
// while long running ones (network, ...) give are run concurrently (`_ -> Cmd(msg)` signatures)
// any value can be wrapped into a `Cmd` in order to be run concurrently using `Cmd.callback : (_ -> msg) -> Cmd(msg)`.


// recursive function using `self`
sum
  : List(Int) -> Int
  = { (), acc -> acc
    | (h, ..q), acc ->
        self(q, acc + h)
    }($, 0)

// # bunch of ideas :
// static dispatch for operator overloading
// evergreen interfaces for clear boundaries and responsibilities
// benchmark, test and deploy in a single bash cmd
// progressive delivery and rollback to get user feedback before full delivery
// privacy conserving bug tracing
// `Int` used in an expression block represents the module and used in a type block represents the type.
// codegen instead of macros to be able to read and fix the code when needed
// have a document explaining why values have been removed or changed and how to fix the implementation (maybe automated code fixes)
// pause debugger, make changes and continue

// red green blue programming
// - red : write failing tests
// - green : write simplest valid implementation that passes tests
// - blue : ensure behavior stays invariable while optimizing and benchmarking

// `[]` for domain specific notations ex: `Version[1.2.0]`, `Date[26/02/1995]`, `Regex[...]`
// or for syntax `Expr[print($str)]( str = #literal(#string("Hello World!")) )`
// `Matrix[ 1, 2, 3 |
//        | 4, 5, 6 |
//        | 7, 8, 9 ]`
// using any craisy operator symbols with their precedence (pratt parser behind)

f($, b, c)
{ d -> f(d, b, c) }

$.min
{ a -> a.min }

list : List((.min : Int, .max : Int))
List.map($.min, list)

// # Accessors :
// --> guaranteed accessors
// `$.min : (min:t, ..) -> t`
// `$.1 : (_, t, ..) -> t`
// `$.#coords.x : #coords(x:t, ..) -> t`
// `$.12 : l:List(t) -> t where List.length(l) > 12`
// --> unsure accessors
// `$.[12] : List(t) -> { t | ?missing_value }`
// `$.["strKey"] : Dict(String, t) -> { t | ?missing_value }`
// `$.[#ok] : Maybe(t) -> { t | ?missing_value }`
// `$.[#north].km : { #north(km:t, ..) | .. } -> { t | ?missing_value }`
// `$.[:t] : { t | .. } -> { t | ?missing_value }`
// # Builders :
// `("hello", .[12] = "twelve", .foo = "foo")`

// `namespace Example as Ex` or `namespace Json.Decode as D`
// `expose concat, prepend from List`
// end of block on "\n\n"
/*
Move files into the static folder and get them as strings and access them via the `Static` module.
```bash
dialang load myFile path="myFile.txt"
dialang load myOtherFile html="..."
```
Those can now be found as `String`s under `Static.myFile` and `Static.myOtherFile`.

```bash
dialang publish MyPackage
```

Move packages in and out of src to edit them and have project specific versions of them.
```bash
dialang hide MyPackage
dialang show MyPackage
```
*/

// use `else` when the type condition can't be checked statically
minus
  : a:Nat, b:Nat -> Nat where a >= b else ?negative_nat
  = ?

three_repeats
  : (Char, Int, String) ** 3
  = ('a', 12, "hello") ** 3
// == ('a', 12, "hello", 'a', 12, "hello", 'a', 12, "hello")

multiline_string =
  \\Hello!
  \\This nice syntax comes from Zig.
  \\I find it gorgeous :3

// find the right balance between concision and expliciteness
// `let-in`, `if-then-else`, `match`, `priv`, `ghost`

// use `Infix(( a, b -> c ), .precedence:Nat, .associativity:{#left | #right})` type to implement infix operators

// locally mutable values are very attractive

// use infix operators from Int and Matrix modules
// this might be needed for disambiguation and for using domain specific infixes
intSum
  : Int, Int -> Int
  = use Int infixes a + b
matrixSum
  : Matrix, Matrix -> Matrix
  = use Matrix infixes a + b

// use `~` symbol for instantiating and modifying variables
genUID
  : ~Seed -> UID
  = { ~seed ->
        rand = Random.step(~seed)

        #_uid(rand)
    }
// instead of having to deal with it in your return
genUID
  : Seed -> (UID, Seed)
  = { seed ->
        rand = Random.step(seed)

        (#_uid(rand.0), rand.newSeed)
    }
/*
```
i = 12
~i = i + 1
dict = ( .["a"] = "AAA", .["b"] = "BBB" )
~dict.["c"] = "CCC"
~dict =|> ( .["d"] = "DDD", ..$ )
```
We only use the `~` when the variable gets modified.
It can be used for function's parameters and local variables only (`List(~Int)` doesn't make sense).
Functions with variable params can't use await.
*/


// specify the order of execution for side effects
// by piping the effectful functions into one an other
() =
  this!(arg1)
  |>_ thanThat!()
  |> andFinally!($)
// equivalent to:
() =
  this(.cap, arg1)
  |> { _ -> thanThat(.cap) }
  |> andFinally(.cap, $)


// for and while loops introduce many concepts
// and they are too different from other languages to feel natural
// so they probably won't land in dialang
find_index : a, List(a) -> Nat
find_index_for
  = { isTarget, list ->
        let
          // let-in block
          i = 1
        for ~elem in list // traverse list
        do
          // repeated let-in block
          ~i =|> increment
        until isTarget(elem) // conditional end
        then i // if ended early
        else ?not_found // otherwise
    }
find_index_while
  = { isTarget, list ->
        let
          // let block
          elem = List.pop(~list)
          i = 0
        while not isTarget(elem) // conditional end
        do
          // repeated let block
          ~i =|> increment
        then
          // in block
          if List.isEmpty(list)
          then ?not_found
          else i
    }
find_index_rec
  : (a -> Bool), List(a) -> { Int | ?not_found }
  = (0, ..$)
    >> { .., [] ->
          ?not_found
       | index, isTarget, [ h, .. ] where isTarget(h) ->
          index
       | index, isTarget, [ _, ..q ] ->
          self(index + 1, isTarget, q)
       }
// some other functions
foldl
  = { func, acc, list -> // write the ~ in params only when the given arg gets modified
        for ~elem in list
        do ~acc = func(elem, acc)
        then acc
    }
foldr
  = { func, acc, list ->
        let ~list =|> List.revert
        while not List.isEmpty(list)
        do ~acc =|> func(List.pop(~list), $)
        then acc
    }
first
  = { func, list ->
        for ~elem in list
        until func(elem)
        then elem // end loop early
        else ?not_found
    }
// compared to the recursive implementations
foldl_rec
  = { func, acc, [h, ..q] ->
        self(func, func(h, acc), q)
    | _, acc, [] ->
        acc
    }
foldr_rec
  = { func, acc, [..q, l] ->
        self(func, func(l, acc), q)
    | _, acc, [] ->
        acc
    }
first_rec
  = { func, [h, ..] where func(h) -> h
    | func, [_, ..q] -> self(func, q)
    }


/*

Code can be run at different phases:
- Run phase : when file is run as a script
- Compile phase : load static content (files, env, etc.), code generation
- Test phase : tests, static checks
- Debug phase : hot reload, time travel debugger
- IDE phase : inline gui
- Prod phase : final users (everything that doesn't have the `@` symbol)

The `@comp`, `@test`, `@debug`, `@ide` can be used in pattern mattching to have different behaviors based on the context.

~~~ this idea is fairly vague ~~~

```
@comp.load : String -> String // takes the path of a file and load its content as a static value
@comp.check : ... // static checking
@comp.test : ... // unit test
@debug.log : .msg:Maybe(String)=#nothing, a -> a // log
@debug.todo : .msg:Maybe(String)=#nothing -> a // crash
@debug.expect : .msg:Maybe(String)=#nothing, (a -> Bool), a -> a // log an error if the expectation is broken

@> 3 + 5 // show the result inline in the ide (= inline repl)
```

*/

// end block when there is no
// no let-in blocks

// left arrow notation `v <- f \n do_something(v)`
// where `f : (a -> b) -> b`
// is equivalent to `f({v -> do_something(v)})`

traverseStruct
  = { ( ._=val, ..rest), acc ->
        // val will cover every named and unnamed fields of the struct
        self(rest, (do_something(val), ..acc))
    | (), acc -> acc
    }($, ())
